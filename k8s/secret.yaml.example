# Template only - do not commit a filled-in copy of this file. Copy to secret.yaml,
# fill in real values, and apply it out-of-band (kubectl apply -f secret.yaml), or better,
# generate it from a real secrets manager (see docs/COMPLIANCE.md /
# docs/RUNBOOK.md for the "Vault/AWS Secrets Manager" discussion) rather than storing
# plaintext secrets in any file at all, tracked or not.
apiVersion: v1
kind: Secret
metadata:
  name: dental-ai-secrets
  namespace: dental-ai
type: Opaque
stringData:
  JWT_SECRET_KEY: "REPLACE_ME_32_PLUS_RANDOM_CHARS"
  FIELD_ENCRYPTION_KEY: "REPLACE_ME_DEDICATED_KEY_NOT_JWT_SECRET"
  POSTGRES_PASSWORD: "REPLACE_ME"
  ADMIN_EMAIL: "admin@example.com"
  ADMIN_PASSWORD: "REPLACE_ME"
  QDRANT_API_KEY: ""
  OPENAI_API_KEY: ""
  TAVILY_API_KEY: ""
